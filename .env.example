# Azure OpenAI / LLM
LLM_ENDPOINT=https://<your-resource>.openai.azure.com/
LLM_API_KEY=<your-api-key>
LLM_DEPLOYMENT=<your-deployment-name>
LLM_API_VERSION=2024-08-01-preview

# Postgres
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>

# Auth
JWT_SECRET_KEY=<generate-a-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Celery broker (only needed when tasks are dispatched via .delay()/.apply_async())
REDIS_URL=redis://localhost:6379/0

# Azure AI Document Intelligence — optional OCR fallback for scanned PDFs / images
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_KEY=

# Grading thresholds (proposed grade only — an auditor confirms or overrides)
GRADE_FULL_COVERAGE_THRESHOLD=90.0
GRADE_PARTIAL_COVERAGE_THRESHOLD=50.0
